<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">Queries List</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a href="/"><i class="lni lni-home"></i> Home</a></li>
                    <li>Queries List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<section class="vendors-list-wrapper py-5">
    <div class="container">
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Name</th>
                        <th scope="col">Phone Number</th>
                        <th scope="col">Email</th>
                        <th scope="col">Subject</th>
                        <th scope="col">Message</th>
                        <th scope="col" class="text-center">Change Status</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Example Row -->
                    <% let i=1; vendors.rows.forEach((vendor)=> { %>
                        <tr>
                            <th scope="row">
                                <%= i %>
                            </th>
                            <td>
                                <%= vendor.name %>
                            </td>
                            <td>
                                <%= vendor.phone %>
                            </td>
                            <td>
                                <%= vendor.email %>
                            </td>
                            <td>
                                <%= vendor.subject %>
                            </td>
                            <td>
                                <%= vendor.message %>
                            </td>



                            <td class="text-center">
                                <% if (vendor.is_read) { %>
                                    <a class="btn btn-sm btn-success me-1"
                                        href="/admin/change-query-status/<%- helper.generateJwtOTPEncrypt(vendor.contact_id) %>/<%- helper.generateJwtOTPEncrypt(vendor.is_read) %>">
                                        Read
                                    </a>

                                    <% } else {%>
                                        <a class="btn btn-sm btn-danger me-1"
                                            href="/admin/change-query-status/<%- helper.generateJwtOTPEncrypt(vendor.contact_id) %>/<%- helper.generateJwtOTPEncrypt(vendor.is_read) %>">
                                            Un-read
                                        </a>
                                        <% } %>

                            </td>
                        </tr>
                        <% i++}) %>


                </tbody>
            </table>
        </div>
        <div class="row">
            <div class="col-12">
                <!-- Pagination -->
                <div class="pagination left">
                    <ul class="pagination-list">
                        <% for (let i=1; i <=totalPages; i++) { %>
                            <li class="<%= i == page ? 'active' : '' %>">
                                <% let url=`?page=${i}` %>

                                    <a href="<%= url %>">
                                        <%= i %>
                                    </a>
                            </li>
                            <% } %>
                    </ul>
                </div>
                <!--/ End Pagination -->
            </div>
        </div>
    </div>
</section>