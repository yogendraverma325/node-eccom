<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">Vendor Domain(s)</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a href="/"><i class="lni lni-home"></i> Home</a></li>
                    <li><a href="/admin/vendors"> Vendor List</a></li>
                    <li>Vendor Domain(s)</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<section class="vendors-list-wrapper py-5">
    <div class="container">



        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Domain Name</th>
                        <th scope="col">View Service Listing</th>
                        <th scope="col" class="text-center">Change Status</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Example Row -->
                    <% let i=1; vendor_services.rows.forEach((vendor_service)=> { %>
                        <tr>
                            <th scope="row">
                                <%= i %>
                            </th>
                            <td>
                                <%= vendor_service.category.categoryName %>
                            </td>
                            <td>
                                <a
                                    href="/admin/vendor-domain-services/<%- helper.generateJwtOTPEncrypt(vendor_service.id) %>">
                                    <i class="fa fa-server fa-2x"></i>
                                </a>
                            </td>
                            <td class="text-center">
                                <% if (vendor_service.status) { %>
                                    <a class="btn btn-sm btn-danger me-1"
                                        href="/admin/change_vendor_domain_status/<%- helper.generateJwtOTPEncrypt(vendor_service.id) %>/<%- helper.generateJwtOTPEncrypt(vendor_service.status) %>">
                                        In-Active
                                    </a>

                                    <% } else {%>
                                        <a class="btn btn-sm btn-success me-1"
                                            href="/admin/change_vendor_domain_status/<%- helper.generateJwtOTPEncrypt(vendor_service.id) %>/<%- helper.generateJwtOTPEncrypt(vendor_service.status) %>">
                                            Active
                                        </a>

                                        <% } %>

                            </td>


                        </tr>
                        <% i++}) %>


                </tbody>
            </table>
        </div>
        <div class="row">
            <div class="col-12">
                <!-- Pagination -->
                <div class="pagination left">
                    <ul class="pagination-list">
                        <% for (let i=1; i <=totalPages; i++) { %>
                            <li class="<%= i == page ? 'active' : '' %>">
                                <% let url=`?page=${i}` %>

                                    <a href="<%= url %>">
                                        <%= i %>
                                    </a>
                            </li>
                            <% } %>
                    </ul>
                </div>
                <!--/ End Pagination -->
            </div>
        </div>
    </div>
</section>