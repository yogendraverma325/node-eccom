<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">Vendor Domain(s)</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a href="/"><i class="lni lni-home"></i> Home</a></li>
                    <li><a href="/admin/vendors"> Vendor List</a></li>
                    <li>Vendor Domain(s)</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<section class="vendors-list-wrapper py-5">
    <div class="container">
        <button class="btn btn-sm btn-primary my-2" data-bs-toggle="modal" data-bs-target="#categoryModal"
            data-vendor-id="<%= helper.generateJwtOTPEncrypt(vendor_id) %>">
            Manage Service Categories
        </button>



        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Domain Name</th>
                        <th scope="col">View Service Listing</th>
                        <th scope="col" class="text-center">Change Status</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Example Row -->
                    <% let i=1; vendor_services.rows.forEach((vendor_service)=> { %>
                        <tr>
                            <th scope="row">
                                <%= i %>
                            </th>
                            <td>
                                <%= vendor_service.category.categoryName %>
                            </td>
                            <td>
                                <a
                                    href="/admin/vendor-domain-services/<%- helper.generateJwtOTPEncrypt(vendor_service.id) %>">
                                    <i class="fa fa-server fa-2x"></i>
                                </a>
                            </td>
                            <td class="text-center">
                                <% if (vendor_service.status) { %>
                                    <a class="btn btn-sm btn-danger me-1"
                                        href="/admin/change_vendor_domain_status/<%- helper.generateJwtOTPEncrypt(vendor_service.id) %>/<%- helper.generateJwtOTPEncrypt(vendor_service.status) %>">
                                        In-Active
                                    </a>

                                    <% } else {%>
                                        <a class="btn btn-sm btn-success me-1"
                                            href="/admin/change_vendor_domain_status/<%- helper.generateJwtOTPEncrypt(vendor_service.id) %>/<%- helper.generateJwtOTPEncrypt(vendor_service.status) %>">
                                            Active
                                        </a>

                                        <% } %>

                            </td>


                        </tr>
                        <% i++}) %>


                </tbody>
            </table>
        </div>
        <div class="row">
            <div class="col-12">
                <!-- Pagination -->
                <div class="pagination left">
                    <ul class="pagination-list">
                        <% for (let i=1; i <=totalPages; i++) { %>
                            <li class="<%= i == page ? 'active' : '' %>">
                                <% let url=`?page=${i}` %>

                                    <a href="<%= url %>">
                                        <%= i %>
                                    </a>
                            </li>
                            <% } %>
                    </ul>
                </div>
                <!--/ End Pagination -->
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form method="POST" action="/admin/vendor-category-mapping">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Vendor Service Category Mapping</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" name="vendorId" value="<%= helper.generateJwtOTPEncrypt(vendor_id) %>">

                    <div class="mb-3">
                        <label class="form-label">Select Categories</label>
                        <select name="categoryIds[]" class="form-select" multiple required>
                            <% filteredCategories.forEach(cat=> { %>
                                <option value="<%= helper.generateJwtOTPEncrypt(cat.catAutoId) %>">
                                    <%= cat.categoryName %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>