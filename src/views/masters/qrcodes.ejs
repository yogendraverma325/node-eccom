<style>
    @media print {
        body * {
            visibility: hidden;
            /* Sab chhupa do */
        }

        #printableArea,
        #printableArea * {
            visibility: visible;
            /* Sirf card dikhao */
        }

        #printableArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .no-print {
            display: none !important;
            /* Buttons ko print se hata do */
        }
    }
</style>
<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">QR Code List</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a href="/"><i class="lni lni-home"></i> Home</a></li>
                    <li>QR Code List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<section class="vendors-list-wrapper py-5">
    <div class="container">
        <a class="btn btn-sm btn-success mb-5" href="/admin/add-qr-code">
            Add QR
        </a>


        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">QR ID</th>
                        <th scope="col">Redirect URL</th>
                        <th scope="col">Created For</th>
                        <th scope="col">Scan Count</th>
                        <th scope="col">View </th>

                    </tr>
                </thead>
                <tbody>
                    <!-- Example Row -->
                    <% let i=1; qr_codesList.rows.forEach((qr_code)=> { %>
                        <tr>
                            <th scope="row">
                                <%= qr_code.qr_codes_auto_id %>
                            </th>
                            <td>
                                <%= qr_code.redirect_url %>
                            </td>
                            <td>
                                <%= qr_code.created_for %>
                            </td>
                            <td>
                                <%= qr_code.scan_count %>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-info me-1 qr_code_print" href="javascript:void(0)"
                                    data-service-item-id="<%- helper.generateJwtOTPEncrypt(qr_code.qr_codes_auto_id) %>">
                                    View And Download
                                </button>

                            </td>

                        </tr>
                        <% i++}) %>


                </tbody>
            </table>
        </div>
        <div class="row">
            <div class="col-12">
                <!-- Pagination -->
                <div class="pagination left">
                    <ul class="pagination-list">
                        <% for (let i=1; i <=totalPages; i++) { %>
                            <li class="<%= i == page ? 'active' : '' %>">
                                <% let url=`?page=${i}` %>

                                    <a href="<%= url %>">
                                        <%= i %>
                                    </a>
                            </li>
                            <% } %>
                    </ul>
                </div>
                <!--/ End Pagination -->
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="qrModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body" id="printableArea">
                <div id="qrcode">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="downloadCardBtn" class="btn btn-success">Download as Image (PNG)</button>
            </div>
        </div>
    </div>
</div>
<script src="/assets/js/qrcode.js"></script>