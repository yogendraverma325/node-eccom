<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">Add Service</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a href="/"><i class="lni lni-home"></i> Home</a></li>
                    <li><a href="/admin/vendors"> Vendors</a></li>
                    <li>Add Service</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="card shadow">

                    <div class="card-body">
                        <% if (formError && Object.keys(formError).length> 0) { %>
                            <div class="alert alert-danger">
                                Please enter details properly
                            </div>
                            <% } %>
                                <form enctype="multipart/form-data" method="post"
                                    action="/admin/add_service_item/<%- helper.generateJwtOTPEncrypt(service_item_id) %>">

                                    <!-- Basic Info -->
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Service Name</label>
                                            <input type="text" class="form-control" name="name"
                                                placeholder="Enter product name">
                                            <% if (formError?.name) { %>
                                                <small class="text-danger">
                                                    <%= formError.name %>
                                                </small>
                                                <% } %>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Short Description</label>
                                        <textarea class="form-control" name="description" rows="2"></textarea>
                                        <% if (formError?.description) { %>
                                            <small class="text-danger">
                                                <%= formError.description %>
                                            </small>
                                            <% } %>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Long Description</label>
                                        <textarea class="form-control" name="long_description" rows="4"></textarea>
                                        <% if (formError?.long_description) { %>
                                            <small class="text-danger">
                                                <%= formError.long_description %>
                                            </small>
                                            <% } %>
                                    </div>

                                    <!-- Image -->
                                    <div class="mb-3">
                                        <label class="form-label">Service Image</label>
                                        <input type="file" class="form-control" name="image">
                                        <% if (formError?.image) { %>
                                            <small class="text-danger">
                                                <%= formError.image %>
                                            </small>
                                            <% } %>
                                    </div>

                                    <!-- Price Section -->
                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Price</label>
                                            <input type="number" step="0.01" class="form-control" name="price">
                                            <% if (formError?.price) { %>
                                                <small class="text-danger">
                                                    <%= formError.price %>
                                                </small>
                                                <% } %>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Offer Price</label>
                                            <input type="number" step="0.01" class="form-control" name="offerprice">
                                            <% if (formError?.offerprice) { %>
                                                <small class="text-danger">
                                                    <%= formError.offerprice %>
                                                </small>
                                                <% } %>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Price Type</label>
                                            <select class="form-select" name="price_type">
                                                <option value="">Select</option>
                                                <option value="Per Hour">Per Hour</option>
                                                <option value="Per Day">Per Day</option>
                                                <option value="Per Night">Per Night</option>
                                                <option value="Per Person">Per Person</option>
                                                <option value="Per Item">Per Item</option>
                                                <option value="Fixed">Fixed</option>
                                            </select>
                                            <% if (formError?.price_type) { %>
                                                <small class="text-danger">
                                                    <%= formError.price_type %>
                                                </small>
                                                <% } %>
                                        </div>
                                    </div>


                                    <div class="row mb-4">
                                        <div class="col-md-4">
                                            <label class="form-label">Capacity</label>
                                            <select class="form-select" name="capacity">
                                                <option value="">Select</option>
                                                <option value="2">2</option>
                                                <option value="4">4</option>
                                                <option value="6">6</option>
                                                <option value="8">8</option>
                                                <option value="10+">10+</option>
                                            </select>
                                            <% if (formError?.capacity) { %>
                                                <small class="text-danger">
                                                    <%= formError.capacity %>
                                                </small>
                                                <% } %>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Unit</label>
                                            <select class="form-select" name="unit">
                                                <option value="">Select</option>
                                                <option value="AC">AC</option>
                                                <option value="NON-AC">NON-AC</option>
                                                <option value="AC-NON-AC">AC-NON-AC</option>
                                                <option value="VEG">VEG</option>
                                                <option value="NON_VEG">NON_VEG</option>
                                                <option value="VEG_NON_VEG">VEG_NON_VEG</option>
                                                <option value="PETROL">Petrol</option>
                                                <option value="DIESEL">Diesel</option>
                                                <option value="CNG">CNG</option>
                                                <option value="PETROL_CNG">Petrol + CNG</option>
                                                <option value="EV">EV</option>
                                            </select>
                                            <% if (formError?.unit) { %>
                                                <small class="text-danger">
                                                    <%= formError.unit %>
                                                </small>
                                                <% } %>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Rating</label>
                                            <input type="number" class="form-control" name="rating">
                                            <% if (formError?.rating) { %>
                                                <small class="text-danger">
                                                    <%= formError.rating %>
                                                </small>
                                                <% } %>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Longitude</label>
                                            <input type="text" class="form-control" name="longitude">
                                            <% if (formError?.longitude) { %>
                                                <small class="text-danger">
                                                    <%= formError.longitude %>
                                                </small>
                                                <% } %>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Latitude</label>
                                            <input type="text" class="form-control" name="latitude">
                                            <% if (formError?.latitude) { %>
                                                <small class="text-danger">
                                                    <%= formError.latitude %>
                                                </small>
                                                <% } %>
                                        </div>

                                    </div>

                                    <!-- Submit -->
                                    <div class="text-end">
                                        <button type="submit" class="btn btn-primary ms-2">Save Product</button>
                                    </div>

                                </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>