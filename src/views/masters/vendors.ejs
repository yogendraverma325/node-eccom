<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">Local Vendors List</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a href="/"><i class="lni lni-home"></i> Home</a></li>
                    <li>Local Vendors List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<section class="vendors-list-wrapper py-5">
    <div class="container">
        <a class="btn btn-sm btn-success mb-5" href="/admin/add-vendor">
            Add Vendor
        </a>


        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Vendor Name</th>
                        <th scope="col">Phone Number</th>
                        <th scope="col">Email</th>
                        <th scope="col">Email</th>
                        <th scope="col">Domain</th>
                        <th scope="col" class="text-center">Change Status</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Example Row -->
                    <% let i=1; vendors.rows.forEach((vendor)=> { %>
                        <tr>
                            <th scope="row">
                                <%= i %>
                            </th>
                            <td>
                                <%= vendor.vendor_name %>
                            </td>
                            <td>
                                <%= vendor.phone %>
                            </td>
                            <td>
                                <%= vendor.email %>
                            </td>
                            <td>
                                <%= vendor.address %>
                            </td>
                            <td>
                                <a href="/admin/vendor-domains/<%- helper.generateJwtOTPEncrypt(vendor.id) %>">
                                    <i class="fa fa-server fa-2x"></i>
                                </a>
                            </td>


                            <td class="text-center">
                                <% if (vendor.status) { %>
                                    <a class="btn btn-sm btn-danger me-1"
                                        href="/admin/change_vendor_status/<%- helper.generateJwtOTPEncrypt(vendor.id) %>/<%- helper.generateJwtOTPEncrypt(vendor.status) %>">
                                        In-Active
                                    </a>

                                    <% } else {%>
                                        <a class="btn btn-sm btn-success me-1"
                                            href="/admin/change_vendor_status/<%- helper.generateJwtOTPEncrypt(vendor.id) %>/<%- helper.generateJwtOTPEncrypt(vendor.status) %>">
                                            Active
                                        </a>

                                        <% } %>
                                            <button class="btn btn-sm btn-primary me-1">Edit</button>

                            </td>
                        </tr>
                        <% i++}) %>


                </tbody>
            </table>
        </div>
        <div class="row">
            <div class="col-12">
                <!-- Pagination -->
                <div class="pagination left">
                    <ul class="pagination-list">
                        <% for (let i=1; i <=totalPages; i++) { %>
                            <li class="<%= i == page ? 'active' : '' %>">
                                <% let url=`?page=${i}` %>

                                    <a href="<%= url %>">
                                        <%= i %>
                                    </a>
                            </li>
                            <% } %>
                    </ul>
                </div>
                <!--/ End Pagination -->
            </div>
        </div>
    </div>
</section>