<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">Edit Service</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a href="/"><i class="lni lni-home"></i> Home</a></li>
                    <li><a href="/admin/vendors"> Vendors</a></li>
                    <li>Edit Service</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow">
                    <div class="card-body">
                        <% if (formError && Object.keys(formError).length> 0) { %>
                            <div class="alert alert-danger">
                                Please enter details properly
                            </div>
                            <% } %>

                                <form enctype="multipart/form-data" method="post"
                                    action="/admin/edit_service_item/<%- helper.generateJwtOTPEncrypt(service_item_id) %>">

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Service Name</label>
                                            <input type="text" class="form-control" name="name"
                                                value="<%= serviceData.name %>" placeholder="Enter product name">
                                            <% if (formError?.name) { %>
                                                <small class="text-danger">
                                                    <%= formError.name %>
                                                </small>
                                                <% } %>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Short Description</label>
                                        <textarea class="form-control" name="description"
                                            rows="2"><%= serviceData.description %></textarea>
                                        <% if (formError?.description) { %>
                                            <small class="text-danger">
                                                <%= formError.description %>
                                            </small>
                                            <% } %>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Long Description</label>
                                        <textarea class="form-control" name="long_description"
                                            rows="4"><%= serviceData.long_description %></textarea>
                                        <% if (formError?.long_description) { %>
                                            <small class="text-danger">
                                                <%= formError.long_description %>
                                            </small>
                                            <% } %>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Product Image</label>
                                        <div class="mb-2">
                                            <small class="text-muted">Current Image:</small><br>
                                            <img src="/<%= serviceData.image %>" alt="current"
                                                style="width: 80px; height: 80px; object-fit: cover; border-radius: 5px;">
                                        </div>
                                        <input type="file" class="form-control" name="image">
                                        <small class="text-muted">Leave empty if you don't want to change the
                                            image</small>
                                        <% if (formError?.image) { %>
                                            <small class="text-danger">
                                                <%= formError.image %>
                                            </small>
                                            <% } %>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Price</label>
                                            <input type="number" step="0.01" class="form-control" name="price"
                                                value="<%= serviceData.price %>">
                                            <% if (formError?.price) { %>
                                                <small class="text-danger">
                                                    <%= formError.price %>
                                                </small>
                                                <% } %>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Offer Price</label>
                                            <input type="number" step="0.01" class="form-control" name="offerprice"
                                                value="<%= serviceData.offerprice %>">
                                            <% if (formError?.offerprice) { %>
                                                <small class="text-danger">
                                                    <%= formError.offerprice %>
                                                </small>
                                                <% } %>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Price Type</label>
                                            <select class="form-select" name="price_type">
                                                <option value="">Select</option>
                                                <% let priceTypes=["Per Hour", "Per Day" , "Per Night" , "Per Person"
                                                    , "Per Item" , "Fixed" ]; %>
                                                    <% priceTypes.forEach(type=> { %>
                                                        <option value="<%= type %>" <%=serviceData.price_type===type
                                                            ? 'selected' : '' %>><%= type %>
                                                        </option>
                                                        <% }) %>
                                            </select>
                                            <% if (formError?.price_type) { %>
                                                <small class="text-danger">
                                                    <%= formError.price_type %>
                                                </small>
                                                <% } %>
                                        </div>
                                    </div>

                                    <div class="row mb-4">
                                        <div class="col-md-4">
                                            <label class="form-label">Capacity</label>
                                            <select class="form-select" name="capacity">
                                                <option value="">Select</option>
                                                <% ["2", "4" , "8" , "10+" ].forEach(cap=> { %>
                                                    <option value="<%= cap %>" <%=serviceData.capacity==cap ? 'selected'
                                                        : '' %>><%= cap %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                            <% if (formError?.capacity) { %>
                                                <small class="text-danger">
                                                    <%= formError.capacity %>
                                                </small>
                                                <% } %>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Unit</label>
                                            <select class="form-select" name="unit">
                                                <option value="">Select</option>
                                                <% ["AC", "NON-AC" , "AC-NON-AC" , "VEG" , "NO-VEG" ].forEach(u=> { %>
                                                    <option value="<%= u %>" <%=serviceData.unit===u ? 'selected' : ''
                                                        %>><%= u %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                            <% if (formError?.unit) { %>
                                                <small class="text-danger">
                                                    <%= formError.unit %>
                                                </small>
                                                <% } %>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Rating</label>
                                            <input type="number" class="form-control" name="rating"
                                                value="<%= serviceData.rating %>">
                                            <% if (formError?.rating) { %>
                                                <small class="text-danger">
                                                    <%= formError.rating %>
                                                </small>
                                                <% } %>
                                        </div>
                                    </div>

                                    <div class="text-end">
                                        <button type="submit" class="btn btn-primary ms-2">Update</button>
                                    </div>

                                </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>