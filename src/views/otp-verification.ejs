<!-- Start Breadcrumbs -->
<style>
    .toggle-password {
        position: absolute;
        right: 12px;
        top: 67%;
        transform: translateY(-50%);
        cursor: pointer;
        font-size: 16px;
        color: #555;
    }

    .toggle-password:hover {
        color: #000;
    }
</style>

<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">OTP Verification </h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a href="/"><i class="lni lni-home"></i> Home</a></li>
                    <li>OTP Verification</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End Breadcrumbs -->

<!-- Start Account Login Area -->
<div class="account-login section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 offset-lg-3 col-md-10 offset-md-1 col-12">
                <form class="card login-form" method="post" action="/user/password-update" method="POST">
                    <div class="card-body">
                        <div class="title">
                            <h3>OTP Verification</h3>
                        </div>
                        <div class="form-group input-group">
                            <label for="reg-fn">OTP</label>
                            <input class="form-control" id="reg-email" required name="otp" value="1234">
                            <% if (formError?.otp) { %>
                                <small class="text-danger">
                                    <%= formError.otp %>
                                </small>
                                <% } %>
                        </div>

                        <div class="form-group input-group password-wrappe">
                            <label for="reg-fn">Password</label>
                            <input type="password" class="form-control" name="password" id="newPassword" required
                                value="12345">
                            <span class="toggle-password" data-target="newPassword">
                                👁️‍🗨️
                            </span>
                            <% if (formError?.password) { %>
                                <small class="text-danger">
                                    <%= formError.password %>
                                </small>
                                <% } %>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between bottom-content">
                            <a class="lost-pass" href="/user/login">Login ?</a>
                        </div>
                        <div class="button">
                            <button class="btn" type="submit">Submit</button>
                        </div>




                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- End Account Login Area -->