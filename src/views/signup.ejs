<!-- Start Breadcrumbs -->
<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">Login</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a href="/"><i class="lni lni-home"></i> Home</a></li>
                    <li>Login</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End Breadcrumbs -->

<!-- Start Account Login Area -->
<div class="account-login section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 offset-lg-3 col-md-10 offset-md-1 col-12">
                <form class="card login-form" method="post">
                    <div class="card-body">
                        <div class="title">
                            <h3>Sign Up Now</h3>
                            <p>Create Your Account.</p>
                        </div>
                        <% if (formError && Object.keys(formError).length> 0) { %>
                            <div class="alert alert-danger">
                                Please enter details properly
                            </div>
                            <% } %>

                                <form action="/user/signup" method="POST">
                                    <div class="form-group input-group">
                                        <label for="reg-fn">name</label>
                                        <input class="form-control" id="reg-email" required name="name" value="">
                                        <% if (formError?.name) { %>
                                            <small class="text-danger">
                                                <%= formError.name %>
                                            </small>
                                            <% } %>
                                    </div>
                                    <div class="form-group input-group">
                                        <label for="reg-fn">Phone</label>
                                        <input class="form-control" id="reg-email" required name="phone" value="">
                                        <% if (formError?.phone) { %>
                                            <small class="text-danger">
                                                <%= formError.phone %>
                                            </small>
                                            <% } %>
                                    </div>
                                    <div class="form-group input-group">
                                        <label for="reg-fn">Email</label>
                                        <input class="form-control" id="reg-email" required name="email" value="">
                                        <% if (formError?.email) { %>
                                            <small class="text-danger">
                                                <%= formError.email %>
                                            </small>
                                            <% } %>
                                    </div>
                                    <div class="form-group input-group">
                                        <label for="reg-fn">Password</label>
                                        <input class="form-control" id="reg-pass" required name="password" value=""
                                            type="password">
                                    </div>

                                    <div class="button">
                                        <button class="btn" type="submit">Sumit</button>
                                    </div>

                                </form>
                                <p class="outer-link">Already have account? <a href="/user/login">Login </a>
                                </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- End Account Login Area -->