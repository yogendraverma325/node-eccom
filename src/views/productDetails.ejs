<!-- Start Item Details -->
<style>
    .meta-data {
        list-style: none;
        /* default bullets hataye */
        padding: 0;
        margin: 10px 0;
        font-family: 'Arial', sans-serif;
        color: #333;
    }

    .meta-data li {
        position: relative;
        padding-left: 18px;
        margin-bottom: 4px;
        font-size: 14px;
        line-height: 1.6;
        transition: transform 0.2s;
    }

    /* Custom bullet - checkmark style */
    .meta-data li::before {
        content: "*";
        /* aap ✓ ya 🎯 bhi use kar sakte ho */
        position: absolute;
        left: 0;
        top: 0;
        color: #4CAF50;
        font-weight: bold;
    }

    /* Hover effect */
    .meta-data li:hover {
        transform: translateX(5px);
        color: #1E88E5;
    }

    .service-info {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        /* spacing between badges */
        margin: 15px 0;
    }

    .info-badge {
        background-color: #f0f0f0;
        color: #333;
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        display: inline-block;
        transition: background-color 0.2s, transform 0.2s;
    }

    /* Bold label */
    .info-badge strong {
        font-weight: 600;
        margin-right: 5px;
    }

    /* Hover effect */
    .info-badge:hover {
        background-color: #1E88E5;
        color: #fff;
        transform: translateY(-2px);
    }

    .feature-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .chip {
        padding: 6px 12px;
        background: #eef2ff;
        color: #3730a3;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        border: 1px solid #c7d2fe;
        transition: 0.2s;
    }

    .chip:hover {
        background: #6366f1;
        color: #fff;
    }

    /* image zoom */
    .main-img {
        overflow: hidden;
        /* Important: keeps the zoom inside the box */
        position: relative;
        cursor: zoom-in !important;
        background-color: #f8f9fa;
        border: 1px solid #eee;
        border-radius: 8px;
    }

    .main-img img {
        transition: transform 0.3s ease;
        /* Smooth transition */
        width: 100%;
        height: auto;
        display: block;
        transform-origin: center center;
        /* Default zoom from center */
    }

    /* When hovering, scale the image */
    .main-img:hover img {
        transform: scale(2);
        /* Adjust 1.5 to 2.0 depending on zoom depth */
    }

    /* image zoom */
</style>
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "<%= productDetails.name %>",
  "image": [
    "https://www.localtravelstay.com/assets/images/featured-categories/<%= productDetails.image %>"
   ],
  "description": "<%= description %>",
  "brand": {
    "@type": "Brand",
    "name": "Local Travel Stay"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://www.localtravelstay.com/services/details/<%= productDetails.slug %>",
    "priceCurrency": "INR",
    "price": "<%= productDetails.price || '0' %>",
    "availability": "https://schema.org/InStock"
  }
}
</script>
<section class="item-details section">
    <div class="container">
        <div class="top-area">
            <div class="row align-items-center">
                <div class="col-lg-6 col-md-12 col-12">
                    <div class="product-images">
                        <main id="gallery">
                            <div class="main-img"
                                style="height: 500px; display: flex; align-items: center; justify-content: center;">
                                <img src="/<%= productDetails.image %>" id="current" alt="<%= productDetails.name %>">
                            </div>
                            <div class="images">
                                <img src="/<%= productDetails.image %>" class="img prodimage" alt="#">
                                <% productDetails.product_images.forEach((el)=> { %>
                                    <img src="/<%= el.image %>" class="img prodimage" alt="#">
                                    <% }) %>

                            </div>
                        </main>
                    </div>
                </div>

                <div class="col-lg-6 col-md-12 col-12">
                    <div class="product-info">
                        <h1 class="title">
                            <%= productDetails.name %>
                        </h1>
                        <% if (productDetails.mappings[0].category.is_price_allowed_to_display===true) { %>
                            <h3 class="price">
                                <i class="fa fa-rupee"></i></i>
                                <%= productDetails.price %>
                                    <% if (productDetails.offerprice) { %>
                                        <span class="cross-price">
                                            <%= productDetails.offerprice %>
                                        </span>
                                        <% } %>
                            </h3>
                            <% } %>
                                <p class="info-text"></p>
                                <%= productDetails.description %>
                                    </p>
                                    <div class="service-info">
                                        <% if (productDetails.mappings[0].category.is_price_allowed_to_display===true) {
                                            %>
                                            <% if (productDetails.price_type) { %>
                                                <span class="info-badge">
                                                    <strong>Price For:</strong>
                                                    <%= productDetails.price_type %>
                                                </span>
                                                <% }} %>


                                                    <% if (productDetails.capacity) { %>
                                                        <span class="info-badge">
                                                            <strong>Capacity:</strong>
                                                            <%= productDetails.capacity %> PAX
                                                        </span>
                                                        <% } %>

                                                            <% if (productDetails.unit) { %>
                                                                <span class="info-badge">
                                                                    <strong>Unit:</strong>
                                                                    <%= productDetails.unit %>
                                                                </span>
                                                                <% } %>
                                    </div>

                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-12">
                                            <ul class="meta-data">

                                                <% productDetails.product_meta_data.forEach((product_meta_data)=> { %>
                                                    <li>
                                                        <%= product_meta_data.meta_data %>
                                                    </li>
                                                    <% }) %>


                                            </ul>
                                        </div>


                                    </div>
                                    <p class="category"><i class="lni lni-tag"></i> Service Provider:<a
                                            href="javascript:void(0)"></a>
                                        <%= productDetails.vendorService.vendor.vendor_name %>
                                            </a>
                                    </p>
                                    <div class="bottom-content">
                                        <div class="row align-items-end">
                                            <div class="col-lg-4 col-md-4 col-12">
                                                <div class="button cart-button">
                                                    <button class="btn" style="width: 100%;" id="bookingModal">Contact
                                                        For

                                                        Booking</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="product-details-info">
            <div class="single-block">
                <div class="row">
                    <div class="col-lg-6 col-12">
                        <div class="info-body custom-responsive-margin">
                            <h4>Details</h4>
                            <p>
                                <%= productDetails.long_description %>
                            </p>
                            <h4>Amenties</h4>
                            <div class="feature-chips">
                                <% productDetails.product_feature_mappings.forEach((feature)=> { %>
                                    <span class="chip">
                                        <%= feature.feature_value %>
                                    </span>
                                    <% }) %>
                            </div>

                        </div>
                    </div>
                    <div class="col-lg-6 col-12">
                        <div class="info-body">
                            <h4>Facilities Information/Package Information</h4>
                            <ul class="normal-list">

                                <% productDetails.specifications.forEach((specification)=>
                                    { %>
                                    <li><span>
                                            <%= specification.specification.specification_name %>
                                                :
                                        </span>
                                        <%= specification.specification_value %>

                                    </li>
                                    <% }) %>


                            </ul>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="menu-main-container container my-5">
        <h2 class="menu-header text-center mb-4">Scopes</h2>

        <% productDetails.menuCategories.forEach(category=> { %>
            <div class="menu-category-block mb-5">
                <h4 class="menu-category-title text-primary border-bottom pb-2 mb-3">
                    <i class="fas fa-utensils me-2"></i>
                    <%= category.category_name %>
                </h4>

                <div class="row g-3">
                    <% category.items.forEach(item=> { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="menu-item-card card h-100 border-0 shadow-sm">
                                <div class="menu-card-body card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="menu-info-wrapper flex-grow-1">
                                            <h6 class="menu-item-name fw-bold mb-1">
                                                <%= item.name %>
                                            </h6>
                                            <p class="menu-item-desc small text-muted mb-0">
                                                <%= item.description ? item.description
                                                    : 'Freshly prepared specialty dish' %>
                                            </p>
                                        </div>

                                        <div class="menu-price-wrapper text-end ms-2">
                                            <% if (item.prices && item.prices.length> 0) { %>
                                                <% item.prices.forEach(priceObj=> { %>
                                                    <div
                                                        class="menu-price-row d-flex justify-content-end align-items-center mb-1">
                                                        <% if (item.prices.length> 1) { %>
                                                            <span
                                                                class="menu-variant-badge badge bg-light text-dark border me-1">
                                                                <%= priceObj.variant_name %>
                                                            </span>
                                                            <% } %>
                                                                <span class="menu-price-value fw-bold text-success">
                                                                    ₹<%= Math.round(priceObj.price) %>
                                                                </span>
                                                    </div>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <span class="menu-no-price text-muted small">N/A</span>
                                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
            </div>
            <% }) %>
    </div>

    <!-- modal -->
    <!-- Button trigger modal -->
    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Service Provider Contact Details</h5>
                </div>
                <div class="modal-body">
                    <div class="row justify-content-center">
                        <div class="col-auto">

                            <div class="mb-3"> <strong>📞 Phone:</strong>
                                <span>
                                    <%= productDetails.vendorService.vendor.phone %>
                                </span>
                            </div>

                            <% if (productDetails.vendorService.vendor.email) { %>
                                <div class="mb-3">
                                    <strong>📧 Email:</strong>
                                    <span>
                                        <%= productDetails.vendorService.vendor.email %>
                                    </span>
                                </div>
                                <% } %>

                                    <div class="mb-3">
                                        <strong>📍 Address:</strong>
                                        <span>
                                            <%= productDetails.vendorService.vendor_services_locations[0].branch_address
                                                %>
                                        </span>
                                    </div>

                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="ClosebookingModal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!-- modal -->
</section>


<script src="/assets/js/productdetails.js"></script>