<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">Contact Us</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a href="/"><i class="lni lni-home"></i> Home</a></li>
                    <li>Contact</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<section id="contact-us" class="contact-us section">
    <div class="container">
        <div class="contact-head">
            <div class="row">
                <div class="col-12">
                    <div class="section-title">
                        <h2>Contact Us</h2>
                        <p>We’d love to hear from you! If you have any questions, need support, or want to share
                            feedback,
                            feel free to reach out to us and our team will get back to you as soon as possible.</p>
                    </div>
                </div>
            </div>
            <div class="contact-info">
                <div class="row">
                    <div class="col-lg-4 col-md-12 col-12">
                        <div class="single-info-head">
                            <!-- Start Single Info -->
                            <div class="single-info">
                                <i class="lni lni-map"></i>
                                <h3>Address</h3>
                                <ul>
                                    <li><%- helper.getValueFromKey(storeInfo,'STORE_ADD') %></li>
                                </ul>
                            </div>
                            <!-- End Single Info -->
                            <!-- Start Single Info -->
                            <div class="single-info">
                                <i class="lni lni-phone"></i>
                                <h3>Call us on</h3>
                                <ul>
                                    <li><a href="tel:<%- helper.getValueFromKey(storeInfo,'PHONE')%>"><%-
                                                helper.getValueFromKey(storeInfo,'PHONE')%></a></li>
                                    <li><a href="tel:<%- helper.getValueFromKey(storeInfo,'PHONE_2')%>"><%-
                                                helper.getValueFromKey(storeInfo,'PHONE_2')%></a></li>
                                </ul>
                            </div>
                            <!-- End Single Info -->
                            <!-- Start Single Info -->
                            <div class="single-info">
                                <i class="lni lni-envelope"></i>
                                <h3>Mail at</h3>
                                <ul>
                                    <li><a href="mailto:<%- helper.getValueFromKey(storeInfo,'EMAIL')%>"><%-
                                                helper.getValueFromKey(storeInfo,'EMAIL')%></a>
                                    </li>
                                </ul>
                            </div>
                            <!-- End Single Info -->
                        </div>
                    </div>
                    <div class="col-lg-8 col-md-12 col-12">
                        <% if (formError && Object.keys(formError).length> 0) { %>
                            <div class="alert alert-danger">
                                Please enter details properly
                            </div>
                            <% } %>
                                <div class="contact-form-head">
                                    <div class="form-main">
                                        <form class="form" method="post" action="/contact">
                                            <div class="row">
                                                <div class="col-lg-6 col-md-6 col-12">
                                                    <div class="form-group">
                                                        <input name="name" type="text" placeholder="Your Name"
                                                            required="required">
                                                        <% if (formError?.name) { %>
                                                            <small class="text-danger">
                                                                <%= formError.name %>
                                                            </small>
                                                            <% } %>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6 col-md-6 col-12">
                                                    <div class="form-group">
                                                        <input name="subject" type="text" placeholder="Your Subject"
                                                            required="required">
                                                        <% if (formError?.subject) { %>
                                                            <small class="text-danger">
                                                                <%= formError.subject %>
                                                            </small>
                                                            <% } %>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6 col-md-6 col-12">
                                                    <div class="form-group">
                                                        <input name="email" type="email" placeholder="Your Email"
                                                            required="required">
                                                        <% if (formError?.email) { %>
                                                            <small class="text-danger">
                                                                <%= formError.email %>
                                                            </small>
                                                            <% } %>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6 col-md-6 col-12">
                                                    <div class="form-group">
                                                        <input name="phone" type="text" placeholder="Your Phone"
                                                            required="required">
                                                        <% if (formError?.phone) { %>
                                                            <small class="text-danger">
                                                                <%= formError.phone %>
                                                            </small>
                                                            <% } %>
                                                    </div>
                                                </div>
                                                <div class="col-12">
                                                    <div class="form-group message">
                                                        <textarea name="message" placeholder="Your Message"></textarea>
                                                        <% if (formError?.message) { %>
                                                            <small class="text-danger">
                                                                <%= formError.message %>
                                                            </small>
                                                            <% } %>
                                                    </div>
                                                </div>
                                                <div class="col-12">
                                                    <div class="form-group button">
                                                        <button type="submit" class="btn ">Submit Message</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>