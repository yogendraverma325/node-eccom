<style>
    /* --- Variables & Reset --- */
    :root {
        --primary: #0d6efd;
        --primary-hover: #0b5ed7;
        --dark: #1a1a1a;
        --light-bg: #f4f7fa;
        --glass: rgba(255, 255, 255, 0.95);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* --- Hero Section --- */
    .menu-service-page {
        overflow-x: hidden;
        /* Prevent horizontal scroll on animations */
    }

    .menu-hero {
        position: relative;
        height: 550px;
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        /* Parallax effect */
        display: flex;
        align-items: center;
        z-index: 1;
        clip-path: ellipse(150% 100% at 50% 0%);
    }

    .menu-no-banner {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%) !important;
        height: 400px;
    }

    .menu-h1 {
        font-family: 'Playfair Display', serif;
        font-weight: 900;
        font-size: clamp(2rem, 5vw, 3.5rem);
        /* Responsive font size */
        letter-spacing: -1px;
        line-height: 1.2;
        color: #fff;
    }

    /* --- Content Wrapper & Cards --- */
    .content-wrapper {
        margin-top: -120px;
        /* Overlap effect */
        position: relative;
        z-index: 10;
        /* Ensures content is above hero */
    }

    .menu-description {
        background: var(--glass);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        padding: 40px;
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.4);
        margin-bottom: 30px;
    }

    /* Fix for Content Typography */
    .menu-description p {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #444;
        margin-bottom: 20px;
    }

    .menu-description h2,
    .menu-description h3 {
        margin-top: 30px;
        font-weight: 700;
        color: var(--dark);
    }

    /* --- Sticky CTA Sidebar --- */
    .menu-cta-box {
        background: var(--dark);
        color: white;
        border-radius: 24px;
        padding: 40px !important;
        position: sticky;
        top: 100px;
        z-index: 20;
        /* Higher than description to avoid overlaps */
        overflow: hidden;
        transition: var(--transition);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .menu-cta-box::before {
        content: "";
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(13, 110, 253, 0.15) 0%, transparent 70%);
        pointer-events: none;
    }

    /* --- Buttons --- */
    .menu-btn-primary {
        background: var(--primary);
        color: white !important;
        border: none;
        padding: 16px 30px;
        border-radius: 14px;
        font-size: 1.1rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: var(--transition);
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.3);
        text-decoration: none;
        cursor: pointer;
        position: relative;
        z-index: 5;
        /* Ensures clickability */
    }

    .menu-btn-primary:hover {
        background: var(--primary-hover);
        transform: translateY(-3px);
        box-shadow: 0 12px 25px rgba(13, 110, 253, 0.4);
    }

    .menu-btn-primary:active {
        transform: translateY(0);
    }

    /* --- Service Chips --- */
    .menu-service-chip {
        padding: 12px 24px;
        background: white;
        border: 1px solid #eee;
        border-radius: 12px;
        font-weight: 600;
        color: var(--dark);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: var(--transition);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03);
    }

    .menu-service-chip i {
        font-size: 0.9rem;
    }

    .menu-service-chip:hover {
        background: var(--primary);
        color: white !important;
        border-color: var(--primary);
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.15);
    }

    /* --- Animations Helpers --- */
    .h-px {
        height: 1px;
        flex-grow: 1;
    }

    .tracking-widest {
        letter-spacing: 0.2em;
    }

    /* --- Mobile Responsive Fixes --- */
    @media (max-width: 991px) {
        .menu-hero {
            height: 400px;
            clip-path: none;
            /* Simplify for mobile performance */
        }

        .content-wrapper {
            margin-top: -60px;
        }

        .menu-cta-box {
            position: static;
            /* Remove sticky on mobile */
            margin-top: 30px;
            padding: 30px !important;
        }

        .menu-description {
            padding: 25px;
        }
    }

    @media (max-width: 576px) {
        .menu-h1 {
            font-size: 1.8rem;
        }

        .menu-btn-primary {
            padding: 14px 20px;
            font-size: 1rem;
        }
    }
</style>
<main class="menu-service-page bg-light">
    <% if (bannerImg) { %>
        <section class="menu-hero"
            style="background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.2)), url('<%= bannerImg %>');">
            <% } else { %>
                <section class="menu-hero menu-no-banner">
                    <% } %>
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-8">
                                    <span class="badge bg-primary px-3 py-2 mb-3 rounded-pill">Top Rated in <%=
                                            citymaster.cityName %></span>
                                    <h1 class="menu-h1 text-white mb-4 animate__animated animate__fadeInUp">
                                        <%= h1Heading %>
                                    </h1>
                                </div>
                            </div>
                        </div>
                </section>

                <div class="container content-wrapper">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="menu-description animate__animated animate__fadeIn">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="flex-grow-1 h-px bg-light"></div>
                                    <span
                                        class="mx-3 text-muted text-uppercase small tracking-widest">Description</span>
                                    <div class="flex-grow-1 h-px bg-light"></div>
                                </div>
                                <%- pageContent %>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="menu-cta-box p-5 shadow-lg position-sticky" style="top: 100px;">
                                <h4 class="fw-bold mb-3">Book Your Ride</h4>
                                <p class="text-white-50 mb-4 small">Discover the best-in-class <%=
                                        service_master.serviceName %> tailored for your <%= citymaster.cityName %> trip.
                                </p>

                                <a href="<%= listingLink %>" class="btn menu-btn-primary w-100 text-white">
                                    <i class="fa fa-calendar-check-o me-2"></i>
                                    <%= buttonText %> Now
                                </a>

                                <div class="mt-4 pt-4 border-top border-secondary text-center">
                                    <p class="small text-muted mb-0">Trusted by 10,000+ Travelers</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <section class="menu-nearby-services py-5 mt-5">
                    <div class="container">
                        <div class="text-center mb-5">
                            <h6 class="text-primary fw-bold text-uppercase">Explore More</h6>
                            <h2 class="fw-bold">Other Services in <%= citymaster.cityName %>
                            </h2>
                        </div>

                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            <% otherServices.forEach(function(s) { %>
                                <a href="/<%= citymaster.cityCode.toLowerCase() %>/<%= s.service_master.serviceSlug %>"
                                    class="menu-service-chip">
                                    <i class="fa fa-map-marker text-primary"></i>
                                    <%= s.service_master.serviceName %>
                                </a>
                                <% }); %>
                        </div>
                    </div>
                </section>
</main>