<style>
    body {
        font-family: Arial, sans-serif;
        background: #f1f3f6;
        padding: 20px;
    }

    .timeline {
        position: relative;
        max-width: 600px;
        margin: 0 auto;
        padding-left: 40px;
    }

    /* Vertical line */
    .timeline::before {
        content: '';
        position: absolute;
        left: 20px;
        top: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(to bottom, #4dabf7, #1971c2);
        border-radius: 2px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 30px;
    }

    .timeline-item:last-child {
        margin-bottom: 0;
    }

    /* Node circle */
    .timeline-item::before {
        content: '';
        position: absolute;
        left: 12px;
        top: 0;
        width: 16px;
        height: 16px;
        background: #4dabf7;
        border: 3px solid #fff;
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgba(77, 171, 247, 0.2);
    }

    .timeline-content {
        background: #fff;
        padding: 12px 15px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        margin-left: 40px;
    }

    .timeline-content strong {
        display: block;
        font-size: 16px;
        margin-bottom: 5px;
    }

    .timeline-content small {
        color: #6c757d;
        font-size: 14px;
    }

    @media (max-width: 480px) {
        .timeline {
            padding-left: 30px;
        }

        .timeline-item::before {
            left: 8px;
        }

        .timeline-content {
            margin-left: 30px;
            padding: 10px;
        }
    }
</style>


<div class="timeline">
    <div class="timeline-item">
        <div class="timeline-content">
            <strong>Pending</strong>
            <small>24 Dec 2025, 10:30 AM</small>
        </div>
    </div>
    <div class="timeline-item">
        <div class="timeline-content">
            <strong>Confirmed</strong>
            <small>25 Dec 2025, 02:15 PM</small>
        </div>
    </div>
    <div class="timeline-item">
        <div class="timeline-content">
            <strong>Shipped</strong>
            <small>26 Dec 2025, 11:00 AM</small>
        </div>
    </div>
    <div class="timeline-item">
        <div class="timeline-content">
            <strong>Delivered</strong>
            <small>28 Dec 2025, 04:45 PM</small>
        </div>
    </div>
</div>