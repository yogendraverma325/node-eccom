<style>
    .timeline {
        position: relative;
        max-width: 700px;
        margin: 0 auto;
        padding: 20px 0 20px 40px;
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 18px;
        top: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(to bottom, #4dabf7, #1971c2);
        border-radius: 2px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 24px;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: 10px;
        top: 8px;
        width: 14px;
        height: 14px;
        background: #4dabf7;
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgba(77, 171, 247, 0.2);
    }

    .timeline-content {
        background: #fff;
        padding: 14px 16px;
        border-radius: 10px;
        margin-left: 40px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .timeline-status {
        font-size: 15px;
        font-weight: 600;
        color: #1971c2;
        margin-bottom: 6px;
    }

    .timeline-meta {
        margin-bottom: 8px;
    }

    .timeline-reason {
        background: #f1f3f5;
        font-size: 13px;
        padding: 4px 8px;
        border-radius: 6px;
        display: inline-block;
    }

    .timeline-remark {
        font-size: 14px;
        line-height: 1.5;
        color: #333;
        margin-bottom: 10px;
    }

    .timeline-date {
        font-size: 12px;
        color: #868e96;
        text-align: right;
    }

    @media (max-width: 576px) {

        .timeline {
            padding-left: 28px;
        }

        .timeline::before {
            left: 12px;
            width: 3px;
        }

        .timeline-item::before {
            left: 6px;
            width: 12px;
            height: 12px;
        }

        .timeline-content {
            margin-left: 28px;
            padding: 12px;
        }

        .timeline-status {
            font-size: 14px;
        }

        .timeline-reason {
            font-size: 12px;
            padding: 3px 6px;
        }

        .timeline-remark {
            font-size: 13px;
        }

        .timeline-date {
            font-size: 11px;
            text-align: left;
            margin-top: 6px;
        }
    }

    .timeline-content {
        transition: transform 0.2s ease;
    }

    .timeline-content:active {
        transform: scale(0.98);
    }
</style>


<div class="timeline">

    <% timelines.forEach(timeline=> { %>
        <div class="timeline-item">
            <div class="timeline-content">

                <!-- STATUS -->
                <div class="timeline-status">
                    <%= timeline.status %>
                </div>

                <!-- META -->
                <div class="timeline-meta">
                    <span class="timeline-reason">
                        remarks: <%= timeline.reason || '—' %>
                    </span>
                </div>

                <!-- REMARK -->
                <% if(timeline.remark){ %>
                    <div class="timeline-meta">
                        <span class="timeline-reason">
                            message: <%= timeline.remark || '—' %>
                        </span>
                    </div>


                    <% } %>

                        <!-- DATE -->
                        <div class="timeline-date">
                            <%= helper.dateToReadAbleFormat(timeline.createdAt) %>
                        </div>

            </div>
        </div>
        <% }); %>

</div>