<section class="featured-categories section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="section-title">
                    <h2>Our Services</h2>
                    <p>Explore our trusted services for a comfortable and hassle-free stay</p>
                </div>
            </div>
        </div>
        <div class="row">
            <% categories.forEach((category)=> { %>
                <div class="col-lg-4 col-md-6 col-12" style="cursor: pointer;">
                    <!-- Start Single Category -->
                    <div class="single-category">
                        <a
                            href="/services?category=<%= category.slug %>&category-id=<%- helper.generateJwtOTPEncrypt(category.catAutoId) %>">

                            <h3 class="heading">
                                <%= category.categoryName %>
                            </h3>
                            <ul>
                                <li><a
                                        href="/services?category=<%= category.slug %>&category-id=<%- helper.generateJwtOTPEncrypt(category.catAutoId) %>"></a>
                                </li>
                                <li><a
                                        href="/services?category=<%= category.slug %>&category-id=<%- helper.generateJwtOTPEncrypt(category.catAutoId) %>"></a>
                                </li>
                                <li><a
                                        href="/services?category=<%= category.slug %>&category-id=<%- helper.generateJwtOTPEncrypt(category.catAutoId) %>"></a>
                                </li>
                                <li><a
                                        href="/services?category=<%= category.slug %>&category-id=<%- helper.generateJwtOTPEncrypt(category.catAutoId) %>"></a>
                                </li>
                                <li><a
                                        href="/services?category=<%= category.slug %>&category-id=<%- helper.generateJwtOTPEncrypt(category.catAutoId) %>"></a>
                                </li>
                            </ul>
                            <div class="images">
                                <img src="/assets/images/featured-categories/<%= category.image %>"
                                    alt="<%= category.categoryName %>">
                            </div>

                    </div>
                    <!-- End Single Category -->
                </div>
                </a>
                <% }) %>
        </div>
    </div>
</section>



<!-- Start Shipping Info -->
<section class="shipping-info">
    <div class="container">
        <ul>
            <!-- Free Shipping -->
            <li>
                <div class="media-icon">
                    <i class="lni lni-delivery"></i>
                </div>
                <div class="media-body">
                    <h5>Trusted Services</h5>
                    <span>Verified rooms, rentals & local providers</span>
                </div>
            </li>
            <!-- Money Return -->
            <li>
                <div class="media-icon">
                    <i class="lni lni-support"></i>
                </div>
                <div class="media-body">
                    <h5>24/7 Support.</h5>
                    <span>Live Chat Or Call.</span>
                </div>
            </li>
            <!-- Support 24/7 -->
            <li>
                <div class="media-icon">
                    <i class="lni lni-credit-cards"></i>
                </div>
                <div class="media-body">
                    <h5>Easy Enquiry.</h5>
                    <span>Quick call & WhatsApp booking</span>
                </div>
            </li>
            <!-- Safe Payment -->
            <li>
                <div class="media-icon">
                    <i class="lni lni-reload"></i>
                </div>
                <div class="media-body">
                    <h5>Best Price Guarantee</h5>
                    <span>No hidden charges.</span>
                </div>
            </li>
        </ul>
    </div>
</section>
<!-- End Shipping Info -->