<style>
    .meta-data {
        list-style: none;
        /* default bullets hataye */
        padding: 0;
        margin: 10px 0;
        font-family: 'Arial', sans-serif;
        color: #333;
    }

    .meta-data li {
        position: relative;
        padding-left: 18px;
        margin-bottom: 4px;
        font-size: 14px;
        line-height: 1.6;
        transition: transform 0.2s;
    }

    /* Custom bullet - checkmark style */
    .meta-data li::before {
        content: "*";
        /* aap ✓ ya 🎯 bhi use kar sakte ho */
        position: absolute;
        left: 0;
        top: 0;
        color: #4CAF50;
        font-weight: bold;
    }

    /* Hover effect */
    .meta-data li:hover {
        transform: translateX(5px);
        color: #1E88E5;
    }
</style>
<section class="product-grids section">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-12">
                <!-- Start Product Sidebar -->
                <div class="product-sidebar">



                    <!-- Start Single Widget -->
                    <div class="single-widget condition">
                        <h3>Filter by Price</h3>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault1">
                            <label class="form-check-label" for="flexCheckDefault1">
                                $50 - $100L (208)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault2">
                            <label class="form-check-label" for="flexCheckDefault2">
                                $100L - $500 (311)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault3">
                            <label class="form-check-label" for="flexCheckDefault3">
                                $500 - $1,000 (485)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault4">
                            <label class="form-check-label" for="flexCheckDefault4">
                                $1,000 - $5,000 (213)
                            </label>
                        </div>
                    </div>

                </div>
                <!-- End Product Sidebar -->
            </div>
            <div class="col-lg-9 col-12">
                <div class="product-grids-head">
                    <div class="product-grid-topbar">
                        <div class="row align-items-center">
                            <div class="col-lg-7 col-md-8 col-12">
                                <div class="product-sorting">
                                    <label for="sorting">Sort by:</label>
                                    <select class="form-control" id="sorting">
                                        <option value="" <%=sort==='' ? 'selected' : '' %>>Popularity</option>
                                        <option value="price_asc" <%=sort==='price_asc' ? 'selected' : '' %>>Low - High
                                            Price</option>
                                        <option value="price_desc" <%=sort==='price_desc' ? 'selected' : '' %>>High -
                                            Low Price</option>
                                        <option value="new_desc" <%=sort==='new_desc' ? 'selected' : '' %>>New Arrival
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-5 col-md-4 col-12">
                                <nav>
                                    <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                        <button class="nav-link">Filters</button>
                                    </div>
                                </nav>
                            </div>
                        </div>
                    </div>
                    <div class="tab-content" id="nav-tabContent">

                        <div class="tab-pane fade active show" id="nav-list" role="tabpanel"
                            aria-labelledby="nav-list-tab">
                            <div class="row">
                                <% products.rows.forEach((product)=> { %>
                                    <div class="col-lg-12 col-md-12 col-12">
                                        <!-- Start Single Product -->
                                        <div class="single-product">
                                            <div class="row align-items-center">
                                                <div class="col-lg-4 col-md-4 col-12">
                                                    <div class="product-image">
                                                        <img src="/assets/images/products/<%= product.image %>"
                                                            alt="<%= product.name %>">
                                                        <div class="button">
                                                            <a href="/service-details/<%- helper.generateJwtOTPEncrypt(product.product_auto_id) %>/<%- product.slug %>/<%- helper.generateJwtOTPEncrypt(product.vendorService.vendor_id) %>"
                                                                class="
                                                        btn"> View</a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-4 col-md-4 col-12">
                                                    <div class="product-info">



                                                        <!-- PRODUCT NAME -->
                                                        <h4 class="title">
                                                            <a
                                                                href="/service-details/<%- helper.generateJwtOTPEncrypt(product.product_auto_id) %>/<%- product.slug %>/<%- helper.generateJwtOTPEncrypt(product.vendorService.vendor_id) %>">
                                                                <%- product.name %>
                                                            </a>
                                                        </h4>

                                                        <!-- RATING -->
                                                        <ul class="review">
                                                            <%- helper.ratingAndReview(product.rating) %>
                                                        </ul>

                                                        <!-- PRICE -->
                                                        <div class="price">
                                                            <span
                                                                class="<%= product.offerprice ? 'price-wrapper' : 'normal-price' %>">
                                                                <i class="fa fa-rupee"></i>

                                                                <% if (product.offerprice) { %>
                                                                    <span class="normal-price">
                                                                        <%= product.price %>
                                                                    </span>
                                                                    <span class="cross-price">
                                                                        <%= product.offerprice %>
                                                                    </span>
                                                                    <% } else { %>
                                                                        <span>
                                                                            <%= product.price %>
                                                                        </span>
                                                                        <% } %>
                                                            </span>
                                                        </div>



                                                    </div>

                                                </div>
                                                <div class="col-lg-4 col-md-4 col-12">
                                                    <ul class="meta-data">
                                                        <% product.product_feature_mappings.forEach((feature)=> { %>
                                                            <li>
                                                                <%= feature.feature_value %>
                                                            </li>
                                                            <% }) %>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- End Single Product -->
                                    </div>
                                    <% }) %>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <!-- Pagination -->
                                    <div class="pagination left">
                                        <ul class="pagination-list">
                                            <% for (let i=1; i <=totalPages; i++) { %>
                                                <li class="<%= i === page ? 'active' : '' %>">
                                                    <% let url=`?page=${i}`; if (categorySlug) { url
                                                        +=`&category=${categorySlug}`; } if (categoryId) { url
                                                        +=`&category-id=${helper.generateJwtOTPEncrypt(categoryId)}`; }
                                                        %>

                                                        <a href="<%= url %>">
                                                            <%= i %>
                                                        </a>
                                                </li>
                                                <% } %>
                                        </ul>
                                    </div>
                                    <!--/ End Pagination -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="/assets/js/productlist.js"></script>