<style>
    .meta-data {
        list-style: none;
        /* default bullets hataye */
        padding: 0;
        margin: 10px 0;
        font-family: 'Arial', sans-serif;
        color: #333;
    }

    .meta-data li {
        position: relative;
        padding-left: 18px;
        margin-bottom: 4px;
        font-size: 14px;
        line-height: 1.6;
        transition: transform 0.2s;
    }

    /* Custom bullet - checkmark style */
    .meta-data li::before {
        content: "*";
        /* aap ✓ ya 🎯 bhi use kar sakte ho */
        position: absolute;
        left: 0;
        top: 0;
        color: #4CAF50;
        font-weight: bold;
    }

    /* Hover effect */
    .meta-data li:hover {
        transform: translateX(5px);
        color: #1E88E5;
    }

    .service-info {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        /* spacing between badges */
        margin: 15px 0;
    }

    .info-badge {
        background-color: #f0f0f0;
        color: #333;
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        display: inline-block;
        transition: background-color 0.2s, transform 0.2s;
    }

    /* Bold label */
    .info-badge strong {
        font-weight: 600;
        margin-right: 5px;
    }

    /* Hover effect */
    .info-badge:hover {
        background-color: #1E88E5;
        color: #fff;
        transform: translateY(-2px);
    }
</style>
<section class="product-grids section">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-12">
                <!-- Start Product Sidebar -->
                <div class="product-sidebar">




                    <div class="single-widget condition d-none d-md-block">
                        <h5 class="modal-title mb-3 border-bottom pb-2">Select Filters</h5>
                        <button class="nav-link btn btn-success openFilterBtn">Filters</button>
                    </div>

                </div>

            </div>
            <div class="col-lg-9 col-12">
                <div class="product-grids-head">
                    <div class="product-grid-topbar">
                        <div class="row align-items-center">
                            <div class="col-lg-6 col-md-6 col-12">
                                <div class="product-sorting">
                                    <label for="sorting">Sort by:</label>
                                    <select class="form-control" id="sorting">
                                        <option value="" <%=sort==='' ? 'selected' : '' %>>Popularity</option>
                                        <option value="price_asc" <%=sort==='price_asc' ? 'selected' : '' %>>Low - High
                                            Price</option>
                                        <option value="price_desc" <%=sort==='price_desc' ? 'selected' : '' %>>High -
                                            Low Price</option>
                                        <option value="new_desc" <%=sort==='new_desc' ? 'selected' : '' %>>Newly Added
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 d-block d-md-none">
                                <nav>
                                    <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                        <button class="nav-link openFilterBtn">Filters</button>
                                    </div>
                                </nav>
                            </div>
                        </div>
                    </div>
                    <div class="tab-content" id="nav-tabContent">

                        <div class="tab-pane fade active show" id="nav-list" role="tabpanel"
                            aria-labelledby="nav-list-tab">
                            <div class="row">
                                <% if (products.rows.length===0) { %>
                                    <div class="col-12">
                                        <div
                                            class="d-flex flex-column align-items-center justify-content-center text-center p-4 bg-white border rounded shadow-sm">

                                            <i class="fa fa-search fa-3x text-primary mb-3"></i>

                                            <h5 class="fw-bold text-dark">No Services Found</h5>

                                            <p class="text-muted mb-3">

                                                We couldn't find any sercice matching your filters.
                                                Try adjusting or clearing the filters.
                                            </p>
                                        </div>
                                    </div>
                                    <% } %>
                                        <% products.rows.forEach((product)=> { %>
                                            <div class="col-lg-12 col-md-12 col-12">
                                                <!-- Start Single Product -->
                                                <div class="single-product">
                                                    <div class="row align-items-center">
                                                        <div class="col-lg-4 col-md-4 col-12">
                                                            <div class="product-image">
                                                                <img src="/<%= product.image %>"
                                                                    alt="<%= product.name %>" loading="lazy">
                                                                <div class="service-info">

                                                                    <%= product.vendorService.vendor_services_locations[0].distance.toFixed(2)
                                                                        %>
                                                                        KM from your locaation


                                                                </div>
                                                                <div class="button">
                                                                    <% if (typeof catData.is_details_page_allowed
                                                                        !=='undefined' &&
                                                                        catData.is_details_page_allowed===true) { %>
                                                                        <a href="/service-details/<%- helper.generateJwtOTPEncrypt(product.product_auto_id) %>/<%- product.slug %>/<%- helper.generateJwtOTPEncrypt(product.vendorService.vendor_id) %>"
                                                                            class="btn">
                                                                            View</a>
                                                                        <% } else { %>
                                                                            <button class="btn booking-modal-btn"
                                                                                style="width: 100%;"
                                                                                data-phone="<%= product.vendorService.vendor.phone %>"
                                                                                data-email="<%= product.vendorService.vendor.email %>"
                                                                                data-address="<%= product.vendorService.vendor_services_locations[0].branch_address %>">View
                                                                                Contact
                                                                                Details</button>


                                                                            <% } %>


                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-4 col-md-4 col-12">
                                                            <div class="product-info">



                                                                <!-- PRODUCT NAME -->
                                                                <h4 class="title">
                                                                    <% if (typeof catData.is_details_page_allowed
                                                                        !=='undefined' &&
                                                                        catData.is_details_page_allowed===true) { %>
                                                                        <a
                                                                            href="/service-details/<%- helper.generateJwtOTPEncrypt(product.product_auto_id) %>/<%- product.slug %>/<%- helper.generateJwtOTPEncrypt(product.vendorService.vendor_id) %>">
                                                                            <%- product.name %>
                                                                        </a>
                                                                        <% } else { %>
                                                                            <a href="javascipt:void(0)"><%- product.name
                                                                                    %></a>

                                                                            <% } %>
                                                                </h4>

                                                                <!-- RATING -->
                                                                <ul class="review">
                                                                    <%- helper.ratingAndReview(product.rating) %>
                                                                </ul>

                                                                <!-- PRICE -->
                                                                <% if (typeof catData.is_price_allowed_to_display
                                                                    !=='undefined' &&
                                                                    catData.is_price_allowed_to_display===true) { %>
                                                                    <div class="price">
                                                                        <span
                                                                            class="<%= product.offerprice ? 'price-wrapper' : 'normal-price' %>">
                                                                            <i class="fa fa-rupee"></i>

                                                                            <% if (product.offerprice) { %>
                                                                                <span class="normal-price">
                                                                                    <%= product.price %>
                                                                                </span>
                                                                                <span class="cross-price">
                                                                                    <%= product.offerprice %>
                                                                                </span>
                                                                                <% } else { %>
                                                                                    <span>
                                                                                        <%= product.price %>
                                                                                    </span>
                                                                                    <% } %>
                                                                        </span>
                                                                    </div>
                                                                    <% } %>
                                                                        <div class="service-info">
                                                                            <% if (typeof
                                                                                catData.is_price_allowed_to_display
                                                                                !=='undefined' &&
                                                                                catData.is_price_allowed_to_display===true)
                                                                                { %>
                                                                                <% if (product.price_type) { %>
                                                                                    <span class="info-badge">
                                                                                        <strong>Price For:</strong>
                                                                                        <%= product.price_type %>
                                                                                    </span>
                                                                                    <% } %>
                                                                                        <% } %>

                                                                                            <% if (product.capacity) {
                                                                                                %>
                                                                                                <span
                                                                                                    class="info-badge">
                                                                                                    <strong>Capacity:</strong>
                                                                                                    <%= product.capacity
                                                                                                        %> PAX
                                                                                                </span>
                                                                                                <% } %>

                                                                                                    <% if (product.unit)
                                                                                                        { %>
                                                                                                        <span
                                                                                                            class="info-badge">
                                                                                                            <strong>Unit:</strong>
                                                                                                            <%= product.unit
                                                                                                                %>
                                                                                                        </span>
                                                                                                        <% } %>
                                                                        </div>



                                                                        <p class="category"><i class="lni lni-tag"></i>
                                                                            Provider:<a href="javascript:void(0)"></a>
                                                                            <%= product.vendorService.vendor.vendor_name
                                                                                %>
                                                                                </a>
                                                                        </p>

                                                            </div>

                                                        </div>
                                                        <div class="col-lg-4 col-md-4 col-12">
                                                            <ul class="meta-data">
                                                                <% product.product_feature_mappings.forEach((feature)=>
                                                                    { %>
                                                                    <li>
                                                                        <%= feature.feature_value %>
                                                                    </li>
                                                                    <% }) %>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- End Single Product -->
                                            </div>
                                            <% }) %>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <!-- Pagination -->
                                    <div class="pagination left">
                                        <ul class="pagination-list">
                                            <% for (let i=1; i <=totalPages; i++) { %>
                                                <li class="<%= i === page ? 'active' : '' %>">
                                                    <% let url=`?page=${i}`; if (categorySlug) { url
                                                        +=`&category=${categorySlug}`; } if (categoryId) { url
                                                        +=`&category-id=${helper.generateJwtOTPEncrypt(categoryId)}`; }
                                                        %>

                                                        <a href="<%= url %>">
                                                            <%= i %>
                                                        </a>
                                                </li>
                                                <% } %>
                                        </ul>
                                    </div>
                                    <!--/ End Pagination -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- filters -->
    <div class="modal fade" id="filterModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Select Filters</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="filter-section mb-4">
                        <h6 class="fw-bold mb-3 border-bottom pb-2">Rating</h6>
                        <% for (let i=1; i <=5; i++) { %>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="rating" id="cat<%= i %>"
                                    value="<%= i %>" <%=rating==i ? "checked" : "" %>
                                >
                                <label class="form-check-label" for="cat<%= i %>">
                                    <%= i %>
                                </label>
                            </div>
                            <% } %>
                    </div>
                    <% if (typeof catData.is_price_allowed_to_display !=='undefined' &&
                        catData.is_price_allowed_to_display===true) { %>
                        <div class="filter-section mb-4">
                            <h6 class="fw-bold mb-3 border-bottom pb-2" id="price-data" data-min="<%= min %>"
                                data-max="<%=max %>" data-pricemin="<%=pricemin %>" data-pricemax="<%=pricemax %>">Price
                            </h6>
                            <div id="dynamicPriceFilters">
                            </div>
                        </div>
                        <% } %>
                </div>
                <div class="modal-footer">
                    <button id="applyFilterBtn" class="btn btn-success w-100">Apply</button>
                    <% if (pricemin || pricemax || rating) { %>
                        <button id="clearFilterBtn" class="btn btn-danger w-100">Clear</button>
                        <% } %>
                </div>
            </div>
        </div>
    </div>
    <!-- filters -->
</section>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Service Provider Contact Details</h5>
            </div>
            <div class="modal-body">
                <div class="row justify-content-center">
                    <div class="col-auto">

                        <div class="mb-3"> <strong>📞 Phone:</strong>
                            <span id="b_phone">

                            </span>
                        </div>

                        <div class="mb-3">
                            <strong>📧 Email:</strong>
                            <span id="b_email">

                            </span>
                        </div>

                        <div class="mb-3">
                            <strong>📍 Address:</strong>
                            <span id="b_address">

                            </span>
                        </div>

                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="ClosebookingModal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- modal -->

<div id="location-overlay"
    style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(240, 36, 36, 0.9); color:white !important; z-index:999; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:20px;">
    <h2 id="location-message" style="color: white !important;"></h2>
    <button id="enable-location-btn"
        style="padding:15px 30px; font-size:18px; background:#ff5722; color:white; border:none; border-radius:5px; cursor:pointer;">
        Enable Location Now
    </button>
</div>

<div class="modal fade" id="locationModal" tabindex="-1" aria-labelledby="locationModalLabel" aria-hidden="true"
    data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="locationModalLabel">📍 Location Access Required</h5>
            </div>
            <div class="modal-content-body p-4">
                <p class="text-muted">To show you nearby services, we need your location. It seems you have blocked
                    location access.</p>

                <h6 class="fw-bold">How to enable:</h6>
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item small">1. Click the <strong>Lock (🔒) icon</strong> in the address bar.
                    </li>
                    <li class="list-group-item small">2. Change <strong>Location</strong> setting to
                        <strong>"Allow"</strong>.
                    </li>
                    <li class="list-group-item small">3. <strong>Refresh</strong> the page to see services.</li>
                </ul>

                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-primary" id="reloadModal">I've Enabled It
                        (Reload Now)</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/assets/js/productlist.js"></script>