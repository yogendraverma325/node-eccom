<style>
    .meta-data {
        list-style: none;
        /* default bullets hataye */
        padding: 0;
        margin: 10px 0;
        font-family: 'Arial', sans-serif;
        color: #333;
    }

    .meta-data li {
        position: relative;
        padding-left: 18px;
        margin-bottom: 4px;
        font-size: 14px;
        line-height: 1.6;
        transition: transform 0.2s;
    }

    /* Custom bullet - checkmark style */
    .meta-data li::before {
        content: "*";
        /* aap ✓ ya 🎯 bhi use kar sakte ho */
        position: absolute;
        left: 0;
        top: 0;
        color: #4CAF50;
        font-weight: bold;
    }

    /* Hover effect */
    .meta-data li:hover {
        transform: translateX(5px);
        color: #1E88E5;
    }
</style>
<section class="product-grids section">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-12">
                <!-- Start Product Sidebar -->
                <div class="product-sidebar">



                    <!-- Start Single Widget -->
                    <div class="single-widget condition d-none d-md-block">
                        <h3>Filter by Price</h3>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="price1">
                            <label class="form-check-label" for="price1">$50 - $100 (208)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="price2">
                            <label class="form-check-label" for="price2">$100 - $500 (311)</label>
                        </div>
                    </div>

                </div>
                <!-- End Product Sidebar -->
            </div>
            <div class="col-lg-9 col-12">
                <div class="product-grids-head">
                    <div class="product-grid-topbar">
                        <div class="row align-items-center">
                            <div class="col-lg-6 col-md-6 col-12">
                                <div class="product-sorting">
                                    <label for="sorting">Sort by:</label>
                                    <select class="form-control" id="sorting">
                                        <option value="" <%=sort==='' ? 'selected' : '' %>>Popularity</option>
                                        <option value="price_asc" <%=sort==='price_asc' ? 'selected' : '' %>>Low - High
                                            Price</option>
                                        <option value="price_desc" <%=sort==='price_desc' ? 'selected' : '' %>>High -
                                            Low Price</option>
                                        <option value="new_desc" <%=sort==='new_desc' ? 'selected' : '' %>>New Arrival
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 d-block d-md-none">
                                <nav>
                                    <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                        <button class="nav-link" id="openFilterBtn">Filters</button>
                                    </div>
                                </nav>
                            </div>
                        </div>
                    </div>
                    <div class="tab-content" id="nav-tabContent">

                        <div class="tab-pane fade active show" id="nav-list" role="tabpanel"
                            aria-labelledby="nav-list-tab">
                            <div class="row">
                                <% products.rows.forEach((product)=> { %>
                                    <div class="col-lg-12 col-md-12 col-12">
                                        <!-- Start Single Product -->
                                        <div class="single-product">
                                            <div class="row align-items-center">
                                                <div class="col-lg-4 col-md-4 col-12">
                                                    <div class="product-image">
                                                        <img src="/assets/images/products/<%= product.image %>"
                                                            alt="<%= product.name %>">
                                                        <div class="button">
                                                            <a href="/service-details/<%- helper.generateJwtOTPEncrypt(product.product_auto_id) %>/<%- product.slug %>/<%- helper.generateJwtOTPEncrypt(product.vendorService.vendor_id) %>"
                                                                class="
                                                        btn"> View</a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-4 col-md-4 col-12">
                                                    <div class="product-info">



                                                        <!-- PRODUCT NAME -->
                                                        <h4 class="title">
                                                            <a
                                                                href="/service-details/<%- helper.generateJwtOTPEncrypt(product.product_auto_id) %>/<%- product.slug %>/<%- helper.generateJwtOTPEncrypt(product.vendorService.vendor_id) %>">
                                                                <%- product.name %>
                                                            </a>
                                                        </h4>

                                                        <!-- RATING -->
                                                        <ul class="review">
                                                            <%- helper.ratingAndReview(product.rating) %>
                                                        </ul>

                                                        <!-- PRICE -->
                                                        <div class="price">
                                                            <span
                                                                class="<%= product.offerprice ? 'price-wrapper' : 'normal-price' %>">
                                                                <i class="fa fa-rupee"></i>

                                                                <% if (product.offerprice) { %>
                                                                    <span class="normal-price">
                                                                        <%= product.price %>
                                                                    </span>
                                                                    <span class="cross-price">
                                                                        <%= product.offerprice %>
                                                                    </span>
                                                                    <% } else { %>
                                                                        <span>
                                                                            <%= product.price %>
                                                                        </span>
                                                                        <% } %>
                                                            </span>
                                                        </div>

                                                        <p class="category"><i class="lni lni-tag"></i> Service
                                                            Provided By:<a href="javascript:void(0)"></a>
                                                            <%= product.vendorService.vendor.vendor_name %>
                                                                </a>
                                                        </p>

                                                    </div>

                                                </div>
                                                <div class="col-lg-4 col-md-4 col-12">
                                                    <ul class="meta-data">
                                                        <% product.product_feature_mappings.forEach((feature)=> { %>
                                                            <li>
                                                                <%= feature.feature_value %>
                                                            </li>
                                                            <% }) %>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- End Single Product -->
                                    </div>
                                    <% }) %>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <!-- Pagination -->
                                    <div class="pagination left">
                                        <ul class="pagination-list">
                                            <% for (let i=1; i <=totalPages; i++) { %>
                                                <li class="<%= i === page ? 'active' : '' %>">
                                                    <% let url=`?page=${i}`; if (categorySlug) { url
                                                        +=`&category=${categorySlug}`; } if (categoryId) { url
                                                        +=`&category-id=${helper.generateJwtOTPEncrypt(categoryId)}`; }
                                                        %>

                                                        <a href="<%= url %>">
                                                            <%= i %>
                                                        </a>
                                                </li>
                                                <% } %>
                                        </ul>
                                    </div>
                                    <!--/ End Pagination -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- filters -->
    <div class="single-widget condition d-none d-md-block">
        <h3>Filter by Price</h3>
    </div>

    <div class="modal fade" id="filterModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Select Filters</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="filter-section mb-4">
                        <h6 class="fw-bold mb-3 border-bottom pb-2">Rating</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" id="cat1" value="1" name="rating">
                            <label class="form-check-label" for="cat1">1</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" id="cat2" value="2" name="rating">
                            <label class="form-check-label" for="cat2">2</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" id="cat3" value="3" name="rating">
                            <label class="form-check-label" for="cat3">3</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" id="cat4" value="4" name="rating">
                            <label class="form-check-label" for="cat2">4</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" id="cat5" value="5" name="rating">
                            <label class="form-check-label" for="cat5">5</label>
                        </div>
                    </div>


                    <div class="filter-section mb-4">
                        <h6 class="fw-bold mb-3 border-bottom pb-2" id="price-data" data-min="<%= min %>"
                            data-max="<%=max %>">Price</h6>
                        <div id="dynamicPriceFilters">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="applyFilterBtn" class="btn btn-success w-100">Apply</button>
                </div>
            </div>
        </div>
    </div>
    <!-- filters -->
</section>

<script src="/assets/js/productlist.js"></script>