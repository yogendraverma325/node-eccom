<footer class="footer bg-white border-top">

    <!-- Footer Middle -->
    <div class="footer-middle py-4">
        <div class="container">
            <div class="row">

                <!-- Column 1: Contact -->
                <div class="col-lg-4 col-md-6 col-12 mb-4">
                    <div class="single-footer">
                        <h5 class="fw-bold mb-3">Get In Touch With Us</h5>
                        <ul class="list-unstyled ps-2 mb-0">
                            <li class="mb-2">
                                <strong>Phone:</strong>
                                <%- helper.getValueFromKey(storeInfo,'PHONE') %>
                            </li>
                            <li class="mb-2">
                                <strong>Monday–Friday:</strong>
                                <%- helper.getValueFromKey(storeInfo,'MON_FRI_TIMING') %>
                            </li>
                            <li class="mb-2">
                                <strong>Saturday–Sunday:</strong>
                                <%- helper.getValueFromKey(storeInfo,'SAT_SUN_TIMING') %>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Column 2: Information -->
                <div class="col-lg-4 col-md-6 col-12 mb-4">
                    <div class="single-footer">
                        <h5 class="fw-bold mb-3">Information</h5>
                        <ul class="list-unstyled ps-2 mb-0">
                            <li class="mb-2"><a href="/about-us" class="text-decoration-none text-dark">About Us</a>
                            </li>
                            <li class="mb-2"><a href="/contact" class="text-decoration-none text-dark">Contact Us</a>
                            </li>
                            <li class="mb-2"><a href="/term-and-condition" class="text-decoration-none text-dark">Terms
                                    & Conditions</a>
                            </li>
                            <li class="mb-2"><a href="/privacy-and-policy"
                                    class="text-decoration-none text-dark">Privacy Policy</a>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Column 3: Services -->
                <div class="col-lg-4 col-md-6 col-12 mb-4">
                    <div class="single-footer">
                        <h5 class="fw-bold mb-3">Our Services</h5>
                        <ul class="list-unstyled ps-2 mb-0">
                            <% hotCategories.forEach((category)=> { %>
                                <li class="mb-2">
                                    <a class="text-decoration-none text-dark"
                                        href="/services?category=<%= category.slug %>&category-id=<%- helper.generateJwtOTPEncrypt(category.catAutoId) %>">
                                        <%= category.categoryName %>
                                    </a>
                                </li>
                                <% }) %>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom border-top py-3">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-md-8 col-12 text-center text-md-start mb-2 mb-md-0">
                    <p class="mb-0">
                        Designed and Developed by
                        <a href="https://graygrids.com/" target="_blank" class="text-decoration-none text-primary">
                            GrayGrids
                        </a>
                    </p>
                </div>

                <div class="col-md-4 col-12 text-center text-md-end">
                    <span class="me-2">Follow Us:</span>
                    <a href="<%- helper.getValueFromKey(storeInfo,'FB_URL') %>" target="_blank" class="me-2 text-dark">
                        <i class="lni lni-facebook-filled"></i>
                    </a>
                    <a href="<%- helper.getValueFromKey(storeInfo,'INSTA_URL') %>" target="_blank" class="text-dark">
                        <i class="lni lni-instagram"></i>
                    </a>
                </div>

            </div>
        </div>
    </div>

</footer>