<header class="header navbar-area">

    <!-- Start Header Middle -->
    <div class="header-middle">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-3 col-md-3 col-7">
                    <!-- Start Header Logo -->
                    <a class="navbar-brand" href="/">
                        <img src="/assets/images/logo/logo.svg" alt="Logo">
                    </a>
                    <!-- End Header Logo -->
                </div>
                <div class="col-lg-5 col-md-7 d-xs-none">
                    <!-- Start Main Menu Search -->
                    <div class="main-menu-search">
                        <!-- navbar search start -->
                        <div class="navbar-search search-style-5">
                            <div class="search-input">
                                <input type="text" placeholder="Search">
                            </div>
                            <div class="search-btn">
                                <button><i class="lni lni-search-alt"></i></button>
                            </div>
                        </div>
                        <!-- navbar search Ends -->
                    </div>
                    <!-- End Main Menu Search -->
                </div>
                <div class="col-lg-4 col-md-2 col-5">
                    <div class="middle-right-area">
                        <!-- <div class="nav-hotline">
                            <i class="lni lni-phone"></i>
                            <h3>Hotline:
                                <span>(+100) 123 456 7890</span>
                            </h3>
                        </div> -->
                        <div class="navbar-cart">
                            <% if (user) { %>
                                <div class="wishlist user-menu">
                                    <a href="javascript:void(0)" class="user-icon">
                                        <i class="lni lni-user"></i>
                                    </a>
                                    <div class="dropdown-menu">
                                        <a href="/profile"><i class="lni lni-user"></i> Profile</a>
                                        <a href="/settings"><i class="lni lni-cog"></i> Settings</a>
                                        <a href="/user/logout"><i class="lni lni-exit"></i> Logout</a>
                                    </div>
                                </div>
                                <% } else { %>
                                    <div class="wishlist">
                                        <a href="/user/login">
                                            <i class="lni lni-user"></i>
                                        </a>
                                    </div>
                                    <% }%>
                                        <!-- <div class="wishlist">
                                <a href="javascript:void(0)">
                                    <i class="lni lni-heart"></i>
                                    <span class="total-items">0</span>
                                </a>
                            </div> -->
                                        <div class="cart-items">
                                            <a href="javascript:void(0)" class="main-btn">
                                                <i class="lni lni-cart"></i>
                                                <span class="total-items">
                                                    <%= cartList.length %>
                                                </span>
                                            </a>
                                            <!-- Shopping Item -->
                                            <div class="shopping-item">
                                                <div class="dropdown-cart-header">
                                                    <span>
                                                        <%= cartList.length %> Items
                                                    </span>
                                                    <a href="/cart">View Cart</a>
                                                </div>
                                                <ul class="shopping-list"
                                                    style="max-height: 250px; overflow-y: auto; overflow-x: hidden;">
                                                    <% cartList.forEach((product)=> { %>
                                                        <li style="margin-right: 20px;">
                                                            <form action="/removeFromCart" method="POST">
                                                                <input type="hidden" name="productAutoId"
                                                                    value="<%= product.cartProducts.productAutoId %>">
                                                                <button type="submit" class="remove">
                                                                    <i class="lni lni-close"></i>
                                                                </button>
                                                            </form>

                                                            <div class="cart-img-head">
                                                                <a class="cart-img"
                                                                    href="/product-details/<%= product.cartProducts.productAutoId %>"><img
                                                                        src="/assets/images/products/<%= product.cartProducts.image %>"
                                                                        alt="<%= product.cartProducts.name %>"></a>
                                                            </div>

                                                            <div class="content">
                                                                <h4><a
                                                                        href="/product-details/<%= product.cartProducts.productAutoId %>">
                                                                        <%= product.cartProducts.name %>
                                                                    </a></h4>
                                                                <p class="quantity">
                                                                    <%= product.qty %> x <span class="amount"><i
                                                                                class="fa fa-rupee"></i>
                                                                            <%= product.cartProducts.price %>
                                                                        </span>
                                                                </p>
                                                            </div>
                                                        </li>
                                                        <% }) %>

                                                </ul>
                                                <div class="bottom">
                                                    <div class="total">
                                                        <span>Total</span>
                                                        <span class="total-amount"><i class="fa fa-rupee"></i>
                                                            <%= cartList.reduce((acc, product)=> acc +
                                                                (product.cartProducts.price * product.qty),
                                                                0).toFixed(2) %>
                                                        </span>
                                                    </div>
                                                    <div class="button">
                                                        <a href="/checkout" class="btn animate">Checkout</a>
                                                    </div>
                                                </div>
                                            </div>
                                            <!--/ End Shopping Item -->
                                        </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Header Middle -->
    <!-- Start Header Bottom -->
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 col-md-6 col-12">
                <div class="nav-inner">
                    <!-- Start Mega Category Menu -->
