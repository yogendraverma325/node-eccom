<style>
    .site-logo {
        height: 60px;
        /* perfect for navbar */
        width: auto;
        object-fit: contain;
    }
</style>
<header class="header navbar-area">

    <!-- Start Header Middle -->
    <div class="header-middle">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-3 col-md-3 col-7">
                    <!-- Start Header Logo -->
                    <a class="navbar-brand" href="/">
                        <img src="/assets/images/logo/logo.png" alt="Local travel stay" class="site-logo">
                    </a>
                    <!-- End Header Logo -->
                </div>
                <div class="col-lg-5 col-md-7 d-xs-none">
                    <!-- Start Main Menu Search -->
                    <div class="main-menu-search">
                        <!-- navbar search start -->
                        <div class="navbar-search search-style-5">
                            <div class="search-input">
                                <input type="text" placeholder="Search" id="searchInput" disabled>
                            </div>
                            <div class="search-btn">
                                <button id="searchBtn"><i class="lni lni-search-alt"></i></button>
                            </div>
                        </div>
                        <!-- navbar search Ends -->
                    </div>
                    <!-- End Main Menu Search -->
                </div>
                <div class="col-lg-4 col-md-2 col-5">
                    <div class="middle-right-area">
                        <!-- <div class="nav-hotline">
                            <i class="lni lni-phone"></i>
                            <h3>Hotline:
                                <span>(+100) 123 456 7890</span>
                            </h3>
                        </div> -->
                        <div class="navbar-cart">
                            <% if (user) { %>
                                <div class="wishlist user-menu">
                                    <a href="javascript:void(0)" class="user-icon">
                                        <i class="lni lni-user"></i>
                                    </a>
                                    <div class="dropdown-menu">
                                        <!-- <a href="/account"><i class="lni lni-user"></i> Account</a> -->
                                        <a href="/user/logout"><i class="lni lni-exit"></i> Logout</a>
                                    </div>
                                </div>
                                <% } else { %>
                                    <div class="wishlist">
                                        <a href="/user/login">
                                            <i class="lni lni-user"></i>
                                        </a>
                                    </div>
                                    <% }%>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Header Middle -->
    <!-- Start Header Bottom -->
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 col-md-6 col-12">
                <div class="nav-inner">
                    <!-- Start Navbar -->
                    <%- include('nav') %>
                        <!-- End Navbar -->
                </div>
            </div>
            <div class="col-lg-4 col-md-6 col-12">
                <!-- Start Nav Social -->
                <!-- <div class="nav-social">
                    <h5 class="title">Follow Us:</h5>
                    <ul>
                        <li>
                            <a href="javascript:void(0)"><i class="lni lni-facebook-filled"></i></a>
                        </li>
                        <li>
                            <a href="javascript:void(0)"><i class="lni lni-instagram"></i></a>
                        </li>

                    </ul>
                </div> -->
                <!-- End Nav Social -->
            </div>
        </div>
    </div>
    <!-- End Header Bottom -->
</header>